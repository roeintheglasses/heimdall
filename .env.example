# Heimdall environment variables
# Copy this file to .env.local (frontend) and set the backend values in your shell,
# in docker-compose.yml, or in Railway.

# ===================
# Frontend (Vercel)
# ===================

# GitHub webhook secret. GitHub signs each delivery with it (x-hub-signature-256).
# Required. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your_github_webhook_secret

# Vercel webhook secret. Vercel returns it when the webhook is created
# (node scripts/add-vercel-webhooks.js). Required to accept Vercel events.
VERCEL_WEBHOOK_SECRET=your_vercel_webhook_secret

# Token for Railway webhooks. Railway cannot sign requests, so the webhook URL carries it:
# https://<your-app>/api/webhook?token=<RAILWAY_WEBHOOK_TOKEN>
# Required to accept Railway events. Generate with: openssl rand -hex 32
RAILWAY_WEBHOOK_TOKEN=your_railway_webhook_token

# Shared secret between the Edge handler and the Go backend (X-Heimdall-Secret header).
# Must be the same value on Vercel and Railway. Generate with: openssl rand -hex 32
BACKEND_WEBHOOK_SECRET=dev-secret

# Go backend URL for server-side calls
GO_SERVICE_URL=http://localhost:8080

# Go backend URL for client-side calls (exposed to the browser)
NEXT_PUBLIC_GO_SERVICE_URL=http://localhost:8080

# Public base URL of the frontend. Used for Open Graph image URLs.
# Falls back to https://$VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
# NEXT_PUBLIC_BASE_URL=https://heimdall.example.com

# Key for /api/debug/env, sent in the x-debug-key header. The route is disabled without it.
# DEBUG_KEY=your_debug_key

# Optional: QStash token for queued delivery to the backend
# QSTASH_TOKEN=your_qstash_token

# ===================
# Backend (Railway/Go)
# ===================

# PostgreSQL connection string (required)
# Format: postgres://user:password@host:port/database?sslmode=require
DATABASE_URL=postgres://heimdall_user:heimdall_password@localhost:5432/heimdall?sslmode=disable

# Set BACKEND_WEBHOOK_SECRET on the backend too, with the same value as the frontend.
# Without it, POST /api/webhook on the backend returns 503.

# Server port (default: 8080)
PORT=8080

# Rate limit per client IP: requests per second (default 10) and burst size (default 30)
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=30

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Human-readable console logs instead of JSON
# PRETTY_LOGS=true

# Failure alerts: POST a short message here when a Vercel or Railway deploy fails
# or a GitHub Actions run fails. Unset means no alerts. The URL is a secret.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Body format: discord, slack, or ntfy. Default: detected from the URL host
# (discord.com, hooks.slack.com, ntfy.sh), else discord.
# ALERT_WEBHOOK_FORMAT=discord

# GitHub token for `go run ./cmd/repos sync` only. The service does not read it.
# GITHUB_TOKEN=ghp_your_token

# ===================
# Tests
# ===================

# Database for the Go integration tests. They truncate events and repo_settings,
# so use a throwaway database that has been migrated.
# docker run -d --rm --name hd-pg -e POSTGRES_PASSWORD=pw -p 55433:5432 postgres:16
# TEST_DATABASE_URL=postgres://postgres:pw@localhost:55433/postgres?sslmode=disable
# Set to 1 to fail, not skip, the database tests when TEST_DATABASE_URL is missing.
# HEIMDALL_REQUIRE_DB=1

# The SSE stream polls the backend every 15 seconds (POLL_INTERVAL_MS in
# src/app/api/events/stream/route.ts). It is not configurable by env.

# ===================
# Development
# ===================

# Set to 'development' for local development
NODE_ENV=development
